YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=https://localhost:8080

# ESPN cookies, one pair per league. The suffix is the league's `creds` value
# in src/ingest/leagues.py. Harvest espn_s2 and SWID from DevTools
# (Application > Cookies > espn.com) while logged in to that league.
# League IDs are not secret and live in leagues.py, not here.

# College Forever (creds "CF")
ESPN_S2_CF=
ESPN_SWID_CF=

# Carrboro (creds "FL")
ESPN_S2_FL=
ESPN_SWID_FL=
